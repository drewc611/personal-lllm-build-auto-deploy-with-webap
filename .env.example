# Copy to .env (gitignored) and fill in. docker compose reads .env automatically.
# Generate the secret with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Bearer token required by POST /run (starts training jobs). The app refuses to
# start without it. Generate with the same command as above.
RUN_API_TOKEN=
# Set to 1 only for a local debugging session; never in a deployed container.
FLASK_DEBUG=0
